# Disposable screen captures from analysis sessions - never commit
captures/

# Narrator speech history - a working record, regenerated every run
logs/

# Large third-party toolchains cloned/extracted into tools/
tools/ghidra_12.1.2_PUBLIC/
tools/ghidra_input/
tools/ghidra_project/

# Session-only scan state
research/scan/state/

# NVDA Controller Client - user-supplied, NV Access's to distribute, not ours
/lib/

# Player's own Thumper install path - every machine's is different, see
# config/game-dir.example.txt
config/game-dir.txt

# Build-Release.ps1 output - regenerated, not source
dist/

# Local Claude Code settings - machine-specific paths/permissions, not for public repo
.claude/settings.local.json
.claude/scheduled_tasks.lock
